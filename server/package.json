{
  "name": "server",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc --noEmit",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "prisma:studio": "bunx --bun prisma studio",
    "test": "echo \"no tests\"",
    "start": "bun /app/server/dist/index.js",
    "dev": "bun --watch src/dev.ts & tsc --watch"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.33",
    "jsonwebtoken": "^9.0.3",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/bun": "^1.3.14",
    "prisma": "^7.9.1"
  }
}
