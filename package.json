{
  "name": "note-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "Full-stack notes application with JWT auth, rotating refresh tokens, and a Bun + Hono + React monorepo architecture",
  "author": "David Moriarty",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidmoriarty/note-manager.git"
  },
  "homepage": "https://note-manager.davidmoriarty.dev",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.9"
  },
  "packageManager": "bun@1.3.9",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": [
      "biome check --write"
    ]
  },
  "workspaces": [
    "./server",
    "./client",
    "./shared"
  ],
  "scripts": {
    "prepare": "husky",
    "precommit": "lint-staged",
    "lint": "biome check .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "dev": "turbo dev",
    "build": "turbo build",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server"
  },
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "tanstack-router",
    "prisma",
    "postgresql",
    "jwt-authentication",
    "refresh-token-rotation",
    "monorepo",
    "turbo"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@tanstack/react-query-devtools": "^5.91.3",
    "bun-types": "^1.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.8.10"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "hono": "^4.10.7"
  }
}
